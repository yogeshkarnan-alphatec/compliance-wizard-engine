# Copy to .env and fill in. config.py reads these via python-dotenv.

# --- Database (psycopg3 driver) ---
# Matches docker-compose.yml credentials. For an external DB (e.g. Supabase), put
# its URL here — the Docker `app` service reads DATABASE_URL from this file.
DATABASE_URL=postgresql+psycopg://compliance:compliance@localhost:5432/compliance_wizard

# --- Docker startup ---
# The combined UI+API container runs migrations + reference-data seed on startup.
# Set RUN_DB_INIT=false when DATABASE_URL is an already-provisioned external DB
# (e.g. Supabase) so the container never mutates that schema. Default: true.
# RUN_DB_INIT=true

# --- OpenAI ---
OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o            # optional override; default in config.py
# OPENAI_MAX_TOKENS=2000

# --- Agentic runtime ---
# LLM_PROVIDER=openai           # openai | anthropic (anthropic needs the `anthropic` extra)
# ANTHROPIC_API_KEY=sk-ant-...  # required only when LLM_PROVIDER=anthropic
# ANTHROPIC_MODEL=claude-sonnet-4-6
# AGENT_MAX_TURNS=20
# EXTRACT_MAX_CHARS=70000       # extraction input cap; fit your OpenAI TPM tier (raise if higher)

# --- Observability (LangSmith, optional; native to LangGraph) ---
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=compliance-wizard

# --- File store (raw PDFs saved by adapters) ---
FILE_STORE_PATH=./file_store

# --- HS code inference (LLM-proposed HS codes from each directive's scope/summary) ---
# HS_INFERENCE_ENABLED=true       # set false to skip the extra LLM call during ingestion
# HS_INFERENCE_MAX_CODES=8        # max validated candidates stored per directive

# --- Worker tuning ---
# WORKER_POLL_INTERVAL_SECONDS=5
# WORKER_BATCH_SIZE=1

# --- Review routing ---
# CONFIDENCE_THRESHOLD=0.75
