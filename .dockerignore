# Keep the build context small and the image clean.
.git
.gitignore
.dockerignore
Dockerfile
docker-compose.yml

# Python
**/__pycache__/
**/*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Node / frontend build artifacts (the image rebuilds these in the node stage)
frontend/node_modules/
frontend/dist/
node_modules/

# Local runtime data & secrets (injected via env at run time)
.env
file_store/

# Editor / OS noise
.vscode/
.idea/
.DS_Store
